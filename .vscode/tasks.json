{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-run",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/MgaAfterDrive/MgaAfterDrive.csproj",
        "-v",
        "q"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true,
        "close": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run-main",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/start-app.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "close": false,
        "echo": true,
        "focus": false,
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "run-setting",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/start-app.ps1",
        "-AppArgs",
        "--settings"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "close": false,
        "echo": true,
        "focus": false,
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
