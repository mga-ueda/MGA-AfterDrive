{
  // F5 / Ctrl+F5 は User keybindings → tasks（run-main / run-setting）
  // 以下は「実行とデバッグ」パネル用
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MGA AfterDrive",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-run",
      "program": "${workspaceFolder}/src/MgaAfterDrive/bin/Debug/net8.0-windows/MGA AfterDrive.exe",
      "args": [],
      "cwd": "${workspaceFolder}/src/MgaAfterDrive/bin/Debug/net8.0-windows",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "MGA AfterDrive Setting",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-run",
      "program": "${workspaceFolder}/src/MgaAfterDrive/bin/Debug/net8.0-windows/MGA AfterDrive.exe",
      "args": ["--settings"],
      "cwd": "${workspaceFolder}/src/MgaAfterDrive/bin/Debug/net8.0-windows",
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
