<UserControl x:Class="MgaAfterDrive.Controls.CaptionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Height="32">
  <Grid Background="Transparent"
        MouseLeftButtonDown="CaptionArea_MouseLeftButtonDown">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Image x:Name="IconImage"
           Grid.Column="0"
           Width="16"
           Height="16"
           Margin="10,0,10,0"
           VerticalAlignment="Center"
           Stretch="Uniform" />

    <TextBlock x:Name="TitleText"
               Grid.Column="1"
               VerticalAlignment="Center"
               Foreground="#F1F1F1"
               TextTrimming="CharacterEllipsis"
               TextWrapping="NoWrap" />

    <Button x:Name="HideButton"
            Grid.Column="2"
            Width="46"
            Height="32"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            Click="HideButton_Click"
            Cursor="Hand"
            Focusable="False"
            ToolTip="トレイに格納">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent">
            <!-- Win11 最小化グリフ -->
            <Rectangle Width="10"
                       Height="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Fill="#F1F1F1" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#3E3E42" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#3F3F46" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
    </Button>
  </Grid>
</UserControl>
