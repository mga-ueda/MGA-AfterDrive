<windows:AppWindow x:Class="MgaAfterDrive.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:MgaAfterDrive.Windows;assembly=MgaAfterDrive.Shared"
        Title="MGA AfterDrive Setting"
        Width="720"
        Height="420"
        MinWidth="560"
        MinHeight="320"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Closing="SettingWindow_Closing"
        Closed="SettingWindow_Closed">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Options -->
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="MaxWaitLabel"
                   VerticalAlignment="Center"
                   Text="最大待機時間"
                   ToolTip="Google Drive プロセス待機とアクセス確認の上限時間（秒）" />
        <TextBox x:Name="MaxWaitTextBox"
                 Width="56"
                 Margin="10,0,10,0"
                 VerticalAlignment="Center"
                 HorizontalContentAlignment="Center"
                 MaxLength="5"
                 Text="180"
                 ToolTip="Google Drive プロセス待機とアクセス確認の上限時間（秒）"
                 PreviewTextInput="MaxWaitTextBox_PreviewTextInput"
                 TextChanged="MaxWaitTextBox_TextChanged"
                 DataObject.Pasting="MaxWaitTextBox_Pasting" />
        <TextBlock VerticalAlignment="Center" Text="秒" />
      </StackPanel>

      <CheckBox x:Name="StartMinimizedCheckBox"
                Margin="0,10,0,0"
                Content="タスクトレイに最小化して起動"
                ToolTip="起動時にウィンドウを出さず、タスクトレイへ格納した状態で開始します。"
                Checked="StartMinimizedCheckBox_Changed"
                Unchecked="StartMinimizedCheckBox_Changed" />

      <TextBlock x:Name="TaskSchedulerNoteLabel"
                 Margin="0,10,0,0"
                 Foreground="{StaticResource ForegroundMutedBrush}"
                 TextWrapping="Wrap"
                 Text="タスク スケジューラへ登録すると、いまの EXE の場所から起動されます。登録後は EXE を移動しないでください。" />

      <Button x:Name="TaskSchedulerButton"
              Margin="0,10,0,0"
              HorizontalAlignment="Left"
              MinWidth="220"
              Style="{StaticResource AccentButton}"
              Content="タスク スケジューラに登録"
              Click="TaskSchedulerButton_Click" />
    </StackPanel>

    <!-- Entries grid -->
    <DataGrid x:Name="EntryGrid"
              Grid.Row="1"
              AllowDrop="True"
              CanUserSortColumns="True"
              EnableRowVirtualization="True"
              Drop="Window_Drop"
              DragOver="Window_DragOver"
              Sorting="EntryGrid_Sorting"
              CellEditEnding="EntryGrid_CellEditEnding"
              PreparingCellForEdit="EntryGrid_PreparingCellForEdit"
              PreviewKeyDown="EntryGrid_PreviewKeyDown">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Delay"
                            Binding="{Binding Delay, UpdateSourceTrigger=PropertyChanged}"
                            Width="70"
                            SortMemberPath="Delay">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="HorizontalAlignment" Value="Center" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="File Name"
                            Binding="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                            Width="120"
                            IsReadOnly="True"
                            SortMemberPath="FileName" />
        <DataGridTextColumn Header="Path"
                            Binding="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                            Width="*"
                            MinWidth="160"
                            SortMemberPath="Path" />
        <DataGridTextColumn Header="Option"
                            Binding="{Binding Option, UpdateSourceTrigger=PropertyChanged}"
                            Width="100"
                            SortMemberPath="Option" />
        <DataGridCheckBoxColumn Width="80"
                               SortMemberPath="Restart"
                               Binding="{Binding Restart, UpdateSourceTrigger=PropertyChanged}">
          <DataGridCheckBoxColumn.Header>
            <TextBlock Text="Restart"
                       ToolTip="Google Drive が一時ダウンした時に、アプリを強制終了させ、復旧した時にアプリを起動し直すかどうか" />
          </DataGridCheckBoxColumn.Header>
        </DataGridCheckBoxColumn>
      </DataGrid.Columns>
      <DataGrid.ContextMenu>
        <ContextMenu Opened="GridContextMenu_Opened">
          <MenuItem x:Name="TestRunMenuItem" Header="Test Run (_R)" Click="TestRunMenuItem_Click" />
          <MenuItem x:Name="DeleteMenuItem" Header="Delete (_D)" Click="DeleteMenuItem_Click" />
        </ContextMenu>
      </DataGrid.ContextMenu>
    </DataGrid>

    <!-- Buttons -->
    <StackPanel Grid.Row="2"
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <Button x:Name="StartAllButton"
              Width="150"
              Margin="0,0,10,0"
              Style="{StaticResource WarningButton}"
              Content="TEST START ALL"
              IsEnabled="False"
              Click="StartAllButton_Click" />
      <Button x:Name="SaveButton"
              Width="110"
              Margin="0,0,10,0"
              Style="{StaticResource DangerButton}"
              Content="SAVE"
              IsEnabled="False"
              Click="SaveButton_Click" />
      <Button x:Name="CancelButton"
              Width="110"
              Style="{StaticResource AccentButton}"
              Content="CANCEL"
              Click="CancelButton_Click" />
    </StackPanel>
  </Grid>
</windows:AppWindow>
