<windows:AppWindow x:Class="MgaAfterDrive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MgaAfterDrive.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:theme="clr-namespace:MgaAfterDrive.Theme;assembly=MgaAfterDrive.Shared"
        xmlns:windows="clr-namespace:MgaAfterDrive.Windows;assembly=MgaAfterDrive.Shared"
        Title="MGA AfterDrive"
        Width="720"
        Height="267"
        MinWidth="560"
        MinHeight="214"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Activated="MainWindow_Activated">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        GlassFrameThickness="0"
                        ResizeBorderThickness="6"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <!-- Acrylic を通すため不透明の黒は使わない（Transparent） -->
  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <controls:CaptionBar x:Name="Caption"
                         Grid.Row="0"
                         HideRequested="Caption_HideRequested" />

    <ListBox x:Name="LogList"
             Grid.Row="1"
             Background="Transparent"
             BorderThickness="0"
             Foreground="{StaticResource LogForegroundBrush}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             VirtualizingPanel.IsVirtualizing="False">
      <ListBox.ContextMenu>
        <ContextMenu Opened="LogContextMenu_Opened">
          <MenuItem x:Name="LogCopyMenuItem" Header="コピー(_C)" Click="LogCopyMenuItem_Click" />
          <MenuItem x:Name="LogClearMenuItem" Header="クリア(_L)" Click="LogClearMenuItem_Click" />
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Stretch"
                     Foreground="{Binding Converter={StaticResource LogLineForegroundConverter}}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Padding" Value="4,1" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{StaticResource LogForegroundBrush}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                  <ContentPresenter />
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
    </ListBox>

    <Border Grid.Row="2"
            Height="{x:Static theme:AppLayout.StatusBarHeight}"
            Background="Transparent"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,0">
      <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LicenseLink"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Cursor="Hand"
                   Foreground="{StaticResource AccentBrush}"
                   Text="Licenses"
                   PreviewMouseLeftButtonUp="LicenseLink_Click" />

        <TextBlock x:Name="SettingLink"
                   Grid.Column="1"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   Cursor="Hand"
                   Foreground="{StaticResource AccentBrush}"
                   Text="Setting"
                   PreviewMouseLeftButtonUp="SettingLink_Click" />

        <TextBlock x:Name="StatusLabel"
                   Grid.Column="2"
                   Margin="10,0,0,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource ForegroundBrush}"
                   TextAlignment="Right"
                   Visibility="Collapsed" />
      </Grid>
    </Border>
  </Grid>
</windows:AppWindow>
