<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>MGA_AfterDrive</RootNamespace>
    <AssemblyName>MGA-AfterDrive</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Product>MGA AfterDrive</Product>
    <AssemblyTitle>MGA AfterDrive</AssemblyTitle>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MGA-AfterDrive.Shared\MGA-AfterDrive.Shared.csproj" />
    <!-- Setting を同時ビルド（EXE 参照はしない。起動は SettingAppLauncher が探す） -->
    <ProjectReference Include="..\MGA-AfterDrive.Setting\MGA-AfterDrive.Setting.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\licenses\WinBlur-LICENSE.txt" LogicalName="MGA_AfterDrive.Licenses.WinBlur-LICENSE.txt" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_NOTICES.md" LogicalName="MGA_AfterDrive.Licenses.THIRD_PARTY_NOTICES.md" />
    <Content Include="..\..\licenses\WinBlur-LICENSE.txt" Link="licenses\WinBlur-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- 開発ビルド: Setting を出力隣へコピー -->
  <Target Name="CopySettingApp" AfterTargets="Build" Condition="'$(PublishSingleFile)' != 'true'">
    <PropertyGroup>
      <_SettingOutDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\MGA-AfterDrive.Setting\bin\$(Configuration)\$(TargetFramework)\'))</_SettingOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_SettingFiles Include="$(_SettingOutDir)MGA-AfterDrive.Setting.exe" />
      <_SettingFiles Include="$(_SettingOutDir)MGA-AfterDrive.Setting.dll" />
      <_SettingFiles Include="$(_SettingOutDir)MGA-AfterDrive.Setting.runtimeconfig.json" />
      <_SettingFiles Include="$(_SettingOutDir)MGA-AfterDrive.Setting.deps.json" />
      <_SettingFiles Include="$(_SettingOutDir)MGA-AfterDrive.Setting.pdb" Condition="Exists('$(_SettingOutDir)MGA-AfterDrive.Setting.pdb')" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_SettingFiles)"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(_SettingOutDir)MGA-AfterDrive.Setting.exe')" />
  </Target>

  <!-- 単一ファイル公開: Setting を単一 EXE でビルドし、メインへ埋め込む -->
  <Target Name="PublishAndEmbedSetting" BeforeTargets="BeforeCompile" Condition="'$(PublishSingleFile)' == 'true'">
    <PropertyGroup>
      <_SettingPublishDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)setting-singlefile\'))</_SettingPublishDir>
      <_SettingPublishExe>$(_SettingPublishDir)MGA-AfterDrive.Setting.exe</_SettingPublishExe>
    </PropertyGroup>
    <MakeDir Directories="$(_SettingPublishDir)" />
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\MGA-AfterDrive.Setting\MGA-AfterDrive.Setting.csproj"
      Targets="Restore;Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;PublishDir=$(_SettingPublishDir);PublishReadyToRun=false" />
    <Error
      Text="単一ファイル公開用の Setting EXE を生成できませんでした: $(_SettingPublishExe)"
      Condition="!Exists('$(_SettingPublishExe)')" />
    <ItemGroup>
      <EmbeddedResource Include="$(_SettingPublishExe)" LogicalName="MGA_AfterDrive.Bundled.Setting.exe" />
    </ItemGroup>
  </Target>

  <!-- 単一ファイル公開フォルダに余分なファイルが残らないようにする -->
  <Target Name="CleanupSingleFilePublishDir" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_PublishExtras Include="$(PublishDir)**\*" Exclude="$(PublishDir)MGA-AfterDrive.exe" />
    </ItemGroup>
    <Delete Files="@(_PublishExtras)" TreatErrorsAsWarnings="true" />
    <RemoveDir Directories="$(PublishDir)licenses" Condition="Exists('$(PublishDir)licenses')" />
  </Target>

</Project>
