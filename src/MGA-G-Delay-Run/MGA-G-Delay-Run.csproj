<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>MGA_G_Delay_Run</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>MGA G Delay Run</Product>
    <AssemblyTitle>MGA G Delay Run</AssemblyTitle>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MGA-G-Delay-Run.Shared\MGA-G-Delay-Run.Shared.csproj" />
    <!-- Setting を同時ビルド（EXE 参照はしない。起動は SettingAppLauncher が探す） -->
    <ProjectReference Include="..\MGA-G-Delay-Run.Setting\MGA-G-Delay-Run.Setting.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\licenses\WinBlur-LICENSE.txt" LogicalName="MGA_G_Delay_Run.Licenses.WinBlur-LICENSE.txt" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_NOTICES.md" LogicalName="MGA_G_Delay_Run.Licenses.THIRD_PARTY_NOTICES.md" />
    <Content Include="..\..\licenses\WinBlur-LICENSE.txt" Link="licenses\WinBlur-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Setting をメイン出力へ同梱（トレイメニュー / 未設定時起動用） -->
  <Target Name="CopySettingApp" AfterTargets="Build">
    <PropertyGroup>
      <_SettingOutDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\MGA-G-Delay-Run.Setting\bin\$(Configuration)\$(TargetFramework)\'))</_SettingOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_SettingFiles Include="$(_SettingOutDir)MGA-G-Delay-Run.Setting.exe" />
      <_SettingFiles Include="$(_SettingOutDir)MGA-G-Delay-Run.Setting.dll" />
      <_SettingFiles Include="$(_SettingOutDir)MGA-G-Delay-Run.Setting.runtimeconfig.json" />
      <_SettingFiles Include="$(_SettingOutDir)MGA-G-Delay-Run.Setting.deps.json" />
      <_SettingFiles Include="$(_SettingOutDir)MGA-G-Delay-Run.Setting.pdb" Condition="Exists('$(_SettingOutDir)MGA-G-Delay-Run.Setting.pdb')" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_SettingFiles)"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(_SettingOutDir)MGA-G-Delay-Run.Setting.dll')" />
  </Target>

</Project>
